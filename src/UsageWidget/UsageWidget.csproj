<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>AIUsageWidget</AssemblyName>
    <RootNamespace>UsageWidget</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../../assets/widget.ico</ApplicationIcon>
    <Version>1.1.0</Version>
    <!-- Footprint: no background GC or tiered recompilation, and only English resources. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredCompilation>false</TieredCompilation>
    <TieredPGO>false</TieredPGO>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
    <InternalsVisibleTo Include="CoreTests" />
    <Resource Include="../../assets/widget.ico" Link="Assets/widget.ico" />
    <Content Include="../../scripts/claude-bridge.cjs" Link="claude-bridge.cjs" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../scripts/setup-claude.cjs" Link="setup-claude.cjs" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../scripts/CONNECT-CLAUDE.cmd" Link="CONNECT-CLAUDE.cmd" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../scripts/DISCONNECT-CLAUDE.cmd" Link="DISCONNECT-CLAUDE.cmd" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../scripts/SHOW-WIDGET.cmd" Link="SHOW-WIDGET.cmd" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../docs/USER-GUIDE.txt" Link="USER-GUIDE.txt" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
