<Window x:Class="UsageWidget.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="AI Usage Widget" Icon="Assets/widget.ico" Width="272" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="True" Foreground="{StaticResource Ink}" FontFamily="Segoe UI">
  <Border Background="#F2111720" BorderBrush="#3A4555" BorderThickness="1" CornerRadius="12" Padding="14,8,14,12">
    <StackPanel>
      <Grid x:Name="DragHandle" Background="Transparent" MouseLeftButtonDown="DragStart" MouseMove="DragMove" MouseLeftButtonUp="DragEnd" LostMouseCapture="DragLost" Cursor="SizeAll" Margin="0,0,-8,6">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="AI USAGE" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
        <Button Grid.Column="1" x:Name="RefreshButton" Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Refresh usage" AutomationProperties.Name="Refresh usage" Click="RefreshClick"/>
        <Button Grid.Column="2" x:Name="PinButton" Style="{StaticResource IconButton}" Content="&#xE841;" AutomationProperties.Name="Toggle always on top" Click="PinClick"/>
        <Button Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE712;" ToolTip="Widget settings" AutomationProperties.Name="Widget settings" Click="OpenMenu"/>
      </Grid>
      <StackPanel x:Name="ClaudePanel"/>
      <Border Height="1" Background="#252E3B" Margin="0,11,0,10"/>
      <StackPanel x:Name="CodexPanel"/>
    </StackPanel>
  </Border>
</Window>
