<Window x:Class="UsageWidget.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="AI Usage Widget" Icon="Assets/widget.ico" Width="336" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="True">
  <Border Background="#EB131B27" BorderBrush="#4C536174" BorderThickness="1" CornerRadius="16" Padding="20,16,20,14">
    <StackPanel>
      <Grid x:Name="DragHandle" Background="Transparent" MouseLeftButtonDown="DragStart" MouseMove="DragMove" MouseLeftButtonUp="DragEnd" LostMouseCapture="DragLost" Cursor="SizeAll" Margin="0,0,0,19">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="AI USAGE" FontSize="11" FontWeight="Bold" Foreground="#9AA6B7"/><TextBlock Text="Room to keep going" FontSize="19" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
        <Button Grid.Column="1" Content="···" FontSize="22" Padding="7,1" VerticalAlignment="Top" ToolTip="Widget settings" AutomationProperties.Name="Widget settings" Click="OpenMenu" Cursor="Hand"/>
      </Grid>
      <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal"><Border Width="8" Height="8" Background="#D99776" CornerRadius="4" Margin="0,0,9,0"/><TextBlock Text="Claude" FontSize="15" FontWeight="SemiBold"/></StackPanel>
        <TextBlock Grid.Column="1" Text="SUBSCRIPTION" Foreground="{StaticResource Muted}" FontSize="9" VerticalAlignment="Center"/>
      </Grid>
      <StackPanel x:Name="ClaudeRows"/>
      <TextBlock x:Name="ClaudeStatus" Foreground="{StaticResource Muted}" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"/>
      <Border Height="1" Background="#303C4C" Margin="0,19,0,17"/>
      <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal"><Border Width="8" Height="8" Background="#87BBA7" CornerRadius="4" Margin="0,0,9,0"/><TextBlock Text="Codex" FontSize="15" FontWeight="SemiBold"/></StackPanel>
        <TextBlock x:Name="CodexPlan" Grid.Column="1" Text="SUBSCRIPTION" Foreground="{StaticResource Muted}" FontSize="9" VerticalAlignment="Center"/>
      </Grid>
      <StackPanel x:Name="CodexRows"/>
      <TextBlock x:Name="CodexStatus" Foreground="{StaticResource Muted}" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"/>
      <Border Height="1" Background="#303C4C" Margin="0,18,0,11"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="ModeLabel" Text="On your desktop" FontSize="10" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
        <Button Grid.Column="1" x:Name="RefreshButton" Content="↻" FontSize="17" Padding="8,2" ToolTip="Refresh Codex usage" AutomationProperties.Name="Refresh Codex usage" Click="RefreshClick"/>
        <Button Grid.Column="2" x:Name="PinButton" Content="↗" FontSize="15" Padding="8,2" ToolTip="Toggle always on top" AutomationProperties.Name="Toggle always on top" Click="PinClick"/>
      </Grid>
    </StackPanel>
  </Border>
</Window>
